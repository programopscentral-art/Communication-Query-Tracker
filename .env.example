# ── Supabase ─────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. NEVER expose to the browser. Used by import + edge functions.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ── App ──────────────────────────────────────────────────
# Base URL used to build BOA deep links inside WhatsApp messages
NEXT_PUBLIC_APP_URL=https://tracker.yourdomain.in

# ── WhatsApp provider ────────────────────────────────────
# provider = mock | meta | aisensy | interakt | gupshup
WHATSAPP_PROVIDER=mock
# Meta Cloud API
META_WABA_PHONE_NUMBER_ID=
META_WABA_TOKEN=
META_WABA_TEMPLATE_NAME=publish_reminder
# BSP (AiSensy / Interakt / Gupshup) — fill the one you use
BSP_API_KEY=
BSP_BASE_URL=

# ── Sheet import ─────────────────────────────────────────
GOOGLE_SHEET_ID=1W6qHfLOP-moOd3sDEHuqRgrzTP6jdUTvLPOYho4AWOo
